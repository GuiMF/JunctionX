      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recommendation"
    },
    "references": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "References",
      "type": "array"
    }
