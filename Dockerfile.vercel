FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=80

# Saved captures need TShark, but do not need live capture privileges.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tshark \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY api ./api
COPY adapters ./adapters
COPY core ./core
COPY export ./export
COPY schemas ./schemas

RUN useradd --create-home --uid 10001 quantumtrace
USER quantumtrace
EXPOSE 80

# Upload IDs and scan results belong to this process: do not add workers.
CMD ["sh", "-c", "exec uvicorn api.main:app --host 0.0.0.0 --port \"${PORT:-80}\" --workers 1"]
